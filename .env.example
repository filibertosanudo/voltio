# Copy to .env and fill in the two secrets. docker-compose.yml reads this
# file; every variable the app understands is validated in lib/env.ts.

# --- Required ---------------------------------------------------------------

# Password of the database's owner role. Any long random string:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs every staff session. Changing it signs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=

# --- Where customers reach the site ------------------------------------------

# Tracking links in emails and the receipt's QR code are built from this.
# In production: the public https URL.
APP_ORIGIN=http://localhost:3100

# Host ports. Change them if something else is already listening.
APP_PORT=3100
DB_PORT=5435
MAIL_UI_PORT=8026

# Reverse proxies in front of the app that overwrite x-forwarded-for
# (Caddy, nginx, a load balancer). The client address used by the rate
# limits and the approval record is read that many entries from the right.
TRUSTED_PROXY_COUNT=1

# --- Email -------------------------------------------------------------------

# Defaults send everything to the bundled MailHog inbox at
# http://localhost:8026. For a real shop, point these at an SMTP provider.
MAIL_DRIVER=smtp
MAIL_FROM_EMAIL=avisos@voltio.local
MAIL_FROM_NAME=
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# 1 for implicit TLS (port 465). Leave 0 for STARTTLS (587) or MailHog.
SMTP_SECURE=0

# --- Demo --------------------------------------------------------------------

# 1 shows one-click sign-in for each role on the login page, using the
# public demo passwords from the seed. Never 1 for a real shop.
DEMO_MODE=0

# --- Without Docker (npm run dev) --------------------------------------------

# DATABASE_URL=postgresql://voltio:<POSTGRES_PASSWORD>@localhost:5435/voltio
# MAIL_DRIVER=console
